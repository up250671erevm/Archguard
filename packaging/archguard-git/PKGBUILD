# Maintainer: up250671erevm
pkgname=archguard-git
_pkgname=archguard
pkgver=0.0.1.r0.g0000000
pkgrel=1
pkgdesc="Blocks Arch Linux upgrades when relevant Arch news needs attention"
arch=('x86_64')
url="https://github.com/up250671erevm/Archguard"
license=('GPL-3.0-or-later')
depends=('libgcc' 'glibc' 'libalpm.so=16-64')
makedepends=('git' 'cargo')
provides=("$_pkgname")
conflicts=("$_pkgname")
optdepends=('meld: graphical 3-way .pacnew merge'
            'libnotify: notify-send fallback for notifications'
            'xdg-utils: open news links from the tray'
            'kdiff3: alternative graphical 3-way .pacnew merge'
            'sudo: elevation for upgrades and /etc writes')
options=('!lto' '!debug')
_features='archguard/alpm,archguard/notify,archguard-tray/alpm,archguard-tray/gui'
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  if git describe --long --tags >/dev/null 2>&1; then
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "0.0.1.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace --features "$_features"
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --workspace --features "$_features"
}

package() {
  cd "$_pkgname"
  install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$_pkgname" "target/release/$_pkgname-tray"
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/user/" \
    packaging/systemd/archguard-check.service packaging/systemd/archguard-check.timer
  install -Dm0644 packaging/archguard-tray.desktop "$pkgdir/usr/share/applications/archguard-tray.desktop"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
